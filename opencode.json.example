{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "imagetooling": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "--name",
        "ImageToolingMCP",
        "--mount",
        "type=bind,src=.,dst=/workspace",
        "imagetooling"
      ],
      "enabled": true
    }
  }
}
